# =====================================================================
# Copy this file to .env.local and paste your own project values.
# =====================================================================
#
# Aturan yang menggantikan konvensi Next.js: apa pun berawalan VITE_ ikut
# masuk ke bundel peramban dan bisa dibaca siapa saja. Rahasia TIDAK BOLEH
# memakai awalan itu — tempatnya di Edge Function atau di skrip maintenance.

# --- Dibutuhkan aplikasi (peramban) ----------------------------------
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Origin publik untuk tautan verifikasi email. Kosongkan di lokal —
# window.location.origin sudah benar. Isi saat deploy.
VITE_SITE_URL=http://localhost:3000

# --- Rahasia: hanya untuk skrip di scripts/ dan Edge Function --------
# Semuanya melewati Row Level Security. Jangan pernah beri awalan VITE_.

#   npm run db:seed        scripts/seed-demo-data.mjs
#   juga dipakai Edge Function `logo-upload` (set lewat: supabase secrets set)
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

#   npm run db:schema      scripts/apply-schema.mjs
#   npm run verify:guards  scripts/verify-guards.mjs
#   qol-desktop/app.go     (koneksi Postgres langsung untuk fitur AI)
# Cloud: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Lokal (`supabase start`): postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

#   npm run email:apply    scripts/apply-email-templates.mjs
# Supabase -> Account -> Access Tokens. Cabut lagi setelah dipakai.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# --- AI LinkedIn Assistant: lokal via Ollama (docs/wails-reengineering-plan.md) ---
# Dibaca qol-desktop/app.go, bukan peramban. Tanpa Ollama jalan, halaman
# /skm/linkedin tetap jalan dengan template deterministik.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_CHAT_MODEL=llama3.2:3b
# LLM_EMBED_MODEL=bge-m3
